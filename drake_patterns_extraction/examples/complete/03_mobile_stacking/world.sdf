<?xml version="1.0"?>
<sdf version="1.6">
  <world name="mobile_stacking_world">

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <drake:proximity_properties>
            <drake:compliant_hydroelastic/>
            <drake:hydroelastic_modulus>1e8</drake:hydroelastic_modulus>
            <drake:mu_dynamic>0.5</drake:mu_dynamic>
            <drake:mu_static>0.7</drake:mu_static>
          </drake:proximity_properties>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mobile base (1-DOF prismatic) with mounted arm -->
    <model name="mobile_manipulator">

      <!-- Virtual world link (for kinematic chain) -->
      <link name="world_link">
        <inertial>
          <mass>0.001</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
      </link>

      <!-- Mobile base platform -->
      <link name="mobile_base">
        <pose>0 0 0.15 0 0 0</pose>
        <inertial>
          <mass>30.0</mass>
          <inertia>
            <ixx>1.5</ixx>
            <iyy>2.0</iyy>
            <izz>2.5</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="base_collision">
          <geometry>
            <box>
              <size>0.6 0.4 0.3</size>
            </box>
          </geometry>
          <drake:proximity_properties>
            <drake:compliant_hydroelastic/>
            <drake:hydroelastic_modulus>1e8</drake:hydroelastic_modulus>
            <drake:mu_dynamic>0.3</drake:mu_dynamic>
            <drake:mu_static>0.5</drake:mu_static>
          </drake:proximity_properties>
        </collision>
        <visual name="base_visual">
          <geometry>
            <box>
              <size>0.6 0.4 0.3</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.3 0.3 0.8 1.0</diffuse>
          </material>
        </visual>
      </link>

      <!-- 1-DOF prismatic joint for base motion (along X-axis) -->
      <joint name="base_prismatic_x" type="prismatic">
        <parent>world_link</parent>
        <child>mobile_base</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit>
            <lower>-1.5</lower>
            <upper>1.5</upper>
            <effort>200</effort>
            <velocity>0.5</velocity>
          </limit>
          <dynamics>
            <damping>5.0</damping>
          </dynamics>
        </axis>
      </joint>

      <!-- Arm mounting platform on top of base -->
      <link name="arm_mount">
        <pose>0 0 0.35 0 0 0</pose>
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.1</ixx>
            <iyy>0.1</iyy>
            <izz>0.1</izz>
          </inertia>
        </inertial>
        <collision name="mount_collision">
          <geometry>
            <box>
              <size>0.3 0.3 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="mount_visual">
          <geometry>
            <box>
              <size>0.3 0.3 0.1</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.2 0.2 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>

      <joint name="base_to_mount" type="fixed">
        <parent>mobile_base</parent>
        <child>arm_mount</child>
      </joint>

    </model>

    <!-- Weld virtual world link to actual world -->
    <joint name="world_to_mobile_system" type="fixed">
      <parent>world</parent>
      <child>mobile_manipulator::world_link</child>
    </joint>

    <!-- Load robot arm (Panda) mounted on mobile base -->
    <model name="panda_arm">
      <include>
        <uri>file://../models/descriptions/robots/arms/franka_description/urdf/panda_arm_hand.urdf</uri>
      </include>
      <pose>0 0 0.4 0 0 0</pose>  <!-- Mounted on arm_mount -->
    </model>

    <!-- Weld arm to mobile base mount -->
    <joint name="mount_to_arm" type="fixed">
      <parent>mobile_manipulator::arm_mount</parent>
      <child>panda_arm::panda_link0</child>
    </joint>

    <!-- Target table (far left) -->
    <model name="table_left">
      <pose>-1.2 0 0.0 0 0 0</pose>
      <static>true</static>
      <link name="table_link">
        <collision name="table_collision">
          <pose>0 0 0.4 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 0.6 0.02</size>
            </box>
          </geometry>
          <drake:proximity_properties>
            <drake:compliant_hydroelastic/>
            <drake:hydroelastic_modulus>1e8</drake:hydroelastic_modulus>
            <drake:mu_dynamic>0.4</drake:mu_dynamic>
            <drake:mu_static>0.6</drake:mu_static>
          </drake:proximity_properties>
        </collision>
        <visual name="table_visual">
          <pose>0 0 0.4 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 0.6 0.02</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.6 0.4 0.2 1.0</diffuse>
          </material>
        </visual>
        <!-- Table legs -->
        <collision name="leg_collision">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 0.1 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_visual">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 0.1 0.4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.5 0.3 0.1 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Source table (far right) with blocks -->
    <model name="table_right">
      <pose>1.2 0 0.0 0 0 0</pose>
      <static>true</static>
      <link name="table_link">
        <collision name="table_collision">
          <pose>0 0 0.4 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 0.6 0.02</size>
            </box>
          </geometry>
          <drake:proximity_properties>
            <drake:compliant_hydroelastic/>
            <drake:hydroelastic_modulus>1e8</drake:hydroelastic_modulus>
            <drake:mu_dynamic>0.4</drake:mu_dynamic>
            <drake:mu_static>0.6</drake:mu_static>
          </drake:proximity_properties>
        </collision>
        <visual name="table_visual">
          <pose>0 0 0.4 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 0.6 0.02</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.6 0.4 0.2 1.0</diffuse>
          </material>
        </visual>
        <collision name="leg_collision">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 0.1 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_visual">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 0.1 0.4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.5 0.3 0.1 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Stackable blocks on right table -->
    <model name="block_red">
      <pose>1.2 0.1 0.435 0 0 0</pose>
      <link name="block_link">
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.00013</ixx>
            <iyy>0.00013</iyy>
            <izz>0.00013</izz>
          </inertia>
        </inertial>
        <collision name="block_collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <drake:proximity_properties>
            <drake:compliant_hydroelastic/>
            <drake:hydroelastic_modulus>1e7</drake:hydroelastic_modulus>
            <drake:mu_dynamic>0.5</drake:mu_dynamic>
            <drake:mu_static>0.7</drake:mu_static>
          </drake:proximity_properties>
        </collision>
        <visual name="block_visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <diffuse>1.0 0.0 0.0 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_green">
      <pose>1.2 0.0 0.435 0 0 0</pose>
      <link name="block_link">
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.00013</ixx>
            <iyy>0.00013</iyy>
            <izz>0.00013</izz>
          </inertia>
        </inertial>
        <collision name="block_collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <drake:proximity_properties>
            <drake:compliant_hydroelastic/>
            <drake:hydroelastic_modulus>1e7</drake:hydroelastic_modulus>
            <drake:mu_dynamic>0.5</drake:mu_dynamic>
            <drake:mu_static>0.7</drake:mu_static>
          </drake:proximity_properties>
        </collision>
        <visual name="block_visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.0 1.0 0.0 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_blue">
      <pose>1.2 -0.1 0.435 0 0 0</pose>
      <link name="block_link">
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.00013</ixx>
            <iyy>0.00013</iyy>
            <izz>0.00013</izz>
          </inertia>
        </inertial>
        <collision name="block_collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <drake:proximity_properties>
            <drake:compliant_hydroelastic/>
            <drake:hydroelastic_modulus>1e7</drake:hydroelastic_modulus>
            <drake:mu_dynamic>0.5</drake:mu_dynamic>
            <drake:mu_static>0.7</drake:mu_static>
          </drake:proximity_properties>
        </collision>
        <visual name="block_visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.0 0.0 1.0 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
