<?xml version="1.0"?>
<sdf version="1.6">
  <world name="door_opening_world">

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <drake:proximity_properties>
            <drake:compliant_hydroelastic/>
            <drake:hydroelastic_modulus>1e8</drake:hydroelastic_modulus>
            <drake:mu_dynamic>0.6</drake:mu_dynamic>
            <drake:mu_static>0.8</drake:mu_static>
          </drake:proximity_properties>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <diffuse>0.6 0.6 0.6 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mobile base (3-DOF planar) with mounted arm -->
    <model name="mobile_manipulator">

      <!-- Virtual world link -->
      <link name="world_link">
        <inertial>
          <mass>0.001</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
      </link>

      <!-- Virtual link for X motion -->
      <link name="virtual_x">
        <inertial>
          <mass>0.001</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
      </link>

      <!-- Virtual link for Y motion -->
      <link name="virtual_y">
        <inertial>
          <mass>0.001</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
      </link>

      <!-- Actual mobile base -->
      <link name="mobile_base">
        <pose>0 0 0.2 0 0 0</pose>
        <inertial>
          <mass>50.0</mass>
          <inertia>
            <ixx>2.5</ixx>
            <iyy>3.5</iyy>
            <izz>4.0</izz>
          </inertia>
        </inertial>
        <collision name="base_collision">
          <geometry>
            <box>
              <size>0.8 0.6 0.4</size>
            </box>
          </geometry>
          <drake:proximity_properties>
            <drake:compliant_hydroelastic/>
            <drake:hydroelastic_modulus>1e8</drake:hydroelastic_modulus>
            <drake:mu_dynamic>0.3</drake:mu_dynamic>
            <drake:mu_static>0.5</drake:mu_static>
          </drake:proximity_properties>
        </collision>
        <visual name="base_visual">
          <geometry>
            <box>
              <size>0.8 0.6 0.4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.2 0.4 0.8 1.0</diffuse>
          </material>
        </visual>
      </link>

      <!-- Kinematic chain for 3-DOF planar motion: X → Y → Yaw -->
      <joint name="base_x" type="prismatic">
        <parent>world_link</parent>
        <child>virtual_x</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit>
            <lower>-2.0</lower>
            <upper>2.0</upper>
            <effort>300</effort>
            <velocity>0.5</velocity>
          </limit>
          <dynamics>
            <damping>10.0</damping>
          </dynamics>
        </axis>
      </joint>

      <joint name="base_y" type="prismatic">
        <parent>virtual_x</parent>
        <child>virtual_y</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-2.0</lower>
            <upper>2.0</upper>
            <effort>300</effort>
            <velocity>0.5</velocity>
          </limit>
          <dynamics>
            <damping>10.0</damping>
          </dynamics>
        </axis>
      </joint>

      <joint name="base_yaw" type="revolute">
        <parent>virtual_y</parent>
        <child>mobile_base</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-3.14159</lower>
            <upper>3.14159</upper>
            <effort>100</effort>
            <velocity>1.0</velocity>
          </limit>
          <dynamics>
            <damping>5.0</damping>
          </dynamics>
        </axis>
      </joint>

      <!-- Arm mounting platform -->
      <link name="arm_mount">
        <pose>0 0 0.45 0 0 0</pose>
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.1</ixx>
            <iyy>0.1</iyy>
            <izz>0.1</izz>
          </inertia>
        </inertial>
        <visual name="mount_visual">
          <geometry>
            <box>
              <size>0.3 0.3 0.1</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.3 0.3 0.3 1.0</diffuse>
          </material>
        </visual>
      </link>

      <joint name="base_to_mount" type="fixed">
        <parent>mobile_base</parent>
        <child>arm_mount</child>
      </joint>

    </model>

    <!-- Weld virtual chain to world -->
    <joint name="world_to_mobile_system" type="fixed">
      <parent>world</parent>
      <child>mobile_manipulator::world_link</child>
    </joint>

    <!-- Load UR5e robot arm -->
    <model name="ur5e_arm">
      <include>
        <uri>file://../models/descriptions/robots/arms/ur_description/urdf/ur5e.urdf</uri>
      </include>
      <pose>0 0 0.5 0 0 0</pose>
    </model>

    <!-- Weld arm to mobile base -->
    <joint name="mount_to_arm" type="fixed">
      <parent>mobile_manipulator::arm_mount</parent>
      <child>ur5e_arm::base_link</child>
    </joint>

    <!-- Door frame (wall with doorway) -->
    <model name="door_frame">
      <pose>1.5 0 0 0 0 0</pose>
      <static>true</static>

      <!-- Left wall -->
      <link name="wall_left">
        <pose>0 -1.5 1.0 0 0 0</pose>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.1 2.0 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.1 2.0 2.0</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.85 0.85 0.75 1.0</diffuse>
          </material>
        </visual>
      </link>

      <!-- Right wall -->
      <link name="wall_right">
        <pose>0 1.5 1.0 0 0 0</pose>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.1 2.0 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.1 2.0 2.0</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.85 0.85 0.75 1.0</diffuse>
          </material>
        </visual>
      </link>

      <!-- Top lintel -->
      <link name="lintel">
        <pose>0 0 2.1 0 0 0</pose>
        <collision name="lintel_collision">
          <geometry>
            <box>
              <size>0.1 1.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="lintel_visual">
          <geometry>
            <box>
              <size>0.1 1.2 0.2</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.85 0.85 0.75 1.0</diffuse>
          </material>
        </visual>
      </link>

      <!-- Door hinge post -->
      <link name="hinge_post">
        <pose>0 -0.5 1.0 0 0 0</pose>
        <collision name="post_collision">
          <geometry>
            <box>
              <size>0.15 0.1 2.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="post_visual">
          <geometry>
            <box>
              <size>0.15 0.1 2.0</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.5 0.3 0.1 1.0</diffuse>
          </material>
        </visual>
      </link>

    </model>

    <!-- Hinged door (articulated environment) -->
    <model name="door">
      <pose>1.5 -0.5 0 0 0 0</pose>

      <link name="door_panel">
        <pose>0 0.45 1.0 0 0 0</pose>
        <inertial>
          <mass>15.0</mass>
          <inertia>
            <ixx>4.0</ixx>
            <iyy>0.2</iyy>
            <izz>4.0</izz>
          </inertia>
        </inertial>
        <collision name="door_collision">
          <geometry>
            <box>
              <size>0.05 0.9 2.0</size>
            </box>
          </geometry>
          <drake:proximity_properties>
            <drake:compliant_hydroelastic/>
            <drake:hydroelastic_modulus>5e7</drake:hydroelastic_modulus>
            <drake:mu_dynamic>0.3</drake:mu_dynamic>
            <drake:mu_static>0.4</drake:mu_static>
          </drake:proximity_properties>
        </collision>
        <visual name="door_visual">
          <geometry>
            <box>
              <size>0.05 0.9 2.0</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.6 0.4 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>

      <!-- Door handle -->
      <link name="door_handle">
        <pose>0.05 0.8 1.0 0 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.01</ixx>
            <iyy>0.01</iyy>
            <izz>0.01</izz>
          </inertia>
        </inertial>
        <collision name="handle_collision">
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.15</length>
            </cylinder>
          </geometry>
          <drake:proximity_properties>
            <drake:compliant_hydroelastic/>
            <drake:hydroelastic_modulus>1e7</drake:hydroelastic_modulus>
            <drake:mu_dynamic>0.6</drake:mu_dynamic>
            <drake:mu_static>0.8</drake:mu_static>
          </drake:proximity_properties>
        </collision>
        <visual name="handle_visual">
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.15</length>
            </cylinder>
          </geometry>
          <material>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
          </material>
        </visual>
      </link>

      <joint name="handle_to_door" type="fixed">
        <parent>door_panel</parent>
        <child>door_handle</child>
      </joint>

    </model>

    <!-- Hinge joint for door (revolute about Z-axis) -->
    <joint name="door_hinge" type="revolute">
      <parent>door_frame::hinge_post</parent>
      <child>door::door_panel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>1.5708</upper>  <!-- 90 degrees -->
          <effort>50</effort>
          <velocity>0.5</velocity>
        </limit>
        <dynamics>
          <damping>2.0</damping>
          <friction>1.0</friction>
        </dynamics>
      </axis>
    </joint>

  </world>
</sdf>
